---
layout: null
permalink: /search.json
---
[
{% for item in site.posts %}
{"title":{{ item.title | jsonify }},"url":{{ item.url | relative_url | jsonify }},"description":{{ item.deck | default: item.excerpt | strip_html | strip_newlines | truncate: 155 | jsonify }},"section":{% if item.categories contains 'Reviews' %}"Music"{% elsif item.categories contains 'Course Evaluation' %}"Course Guide"{% else %}"Writing"{% endif %}},
{% endfor %}
{% for item in site.notes %}{% unless item.published == false %}
{"title":{{ item.title | jsonify }},"url":{{ item.url | relative_url | jsonify }},"description":{{ item.summary | default: item.description | default: '' | jsonify }},"section":"Notes"},
{% endunless %}{% endfor %}
{% for item in site.data.publications %}
{"title":{{ item.title | jsonify }},"url":{{ '/publications/' | relative_url | jsonify }},"description":{{ item.description | jsonify }},"section":"Research"}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
